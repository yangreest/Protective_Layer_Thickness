<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="300dip"
        android:layout_height="match_parent"
        android:background="@drawable/bg_fillet"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/view_line"
            android:orientation="vertical"
            android:paddingLeft="20dip"
            android:paddingTop="20dip"
            android:paddingRight="20dip"
            android:paddingBottom="10dip">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/dialog_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:textColor="@color/color333"
                    android:textSize="16dp" />
            </ScrollView>
        </LinearLayout>

        <View
            android:id="@+id/view_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_above="@+id/layout_1"
            android:background="#BABABA" />

        <RelativeLayout
            android:id="@+id/layout_1"
            android:layout_width="match_parent"
            android:layout_height="45dip"
            android:layout_alignParentBottom="true"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dip"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_dialog_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dialog_left_selector"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="确定确定"
                    android:textColor="@drawable/btn_dialog_text_selector"
                    android:textSize="16dp" />

                <TextView
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="#BABABA" />

                <Button
                    android:id="@+id/btn_dialog_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dialog_right_selector"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="取消"
                    android:textColor="@drawable/btn_dialog_text_selector"
                    android:textSize="16dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_dialog_ok"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_dialog_ok_selector"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="取消"
                android:textColor="@drawable/btn_dialog_text_selector"
                android:textSize="16dp"
                android:visibility="gone" />
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>